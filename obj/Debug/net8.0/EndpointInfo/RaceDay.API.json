            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OrganiserUpdateDto": {
        "type": "object",
        "properties": {
          "organisationName": {
            "type": "string",
            "nullable": true
          },
          "contactPhone": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ParticipantUpdateDto": {
