  "components": {
    "schemas": {
      "CategoryCreateDto": {
        "required": [
          "categoryName",
          "categoryType",
          "distanceKm",
          "entryFee"
        ],
        "type": "object",
        "properties": {
          "categoryName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "categoryType": {
            "minLength": 1,
            "pattern": "^(Running|Walking|Cycling)$",
            "type": "string"
          },
          "distanceKm": {
            "maximum": 999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "ageMin": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "ageMax": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "genderRestriction": {
            "pattern": "^(Male|Female)$",
            "type": "string",
            "nullable": true
          },
          "entryFee": {
            "maximum": 100000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "maxParticipants": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EnrolmentCreateDto": {
        "required": [
          "categoryId"
        ],
        "type": "object",
        "properties": {
