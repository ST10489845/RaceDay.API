          "eventName",
          "province",
          "registrationDeadline",
          "venue"
        ],
        "type": "object",
        "properties": {
          "eventName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "eventDescription": {
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "registrationDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "venue": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "city": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "province": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
