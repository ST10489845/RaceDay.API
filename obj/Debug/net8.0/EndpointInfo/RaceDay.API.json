            "format": "date-time"
          },
          "gender": {
            "type": "string",
            "nullable": true
          },
          "emergencyContactName": {
            "type": "string",
            "nullable": true
          },
          "emergencyContactPhone": {
            "type": "string",
            "nullable": true
          },
          "medicalConditions": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
