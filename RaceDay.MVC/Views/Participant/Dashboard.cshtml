@model List<RaceDay.MVC.ViewModels.EventListViewModel>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">
    <h2 class="mb-4">Upcoming Events</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row">
        @foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@ev.EventName</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@ev.EventDate.ToString("dd MMM yyyy")</h6>
                        <p class="card-text">@ev.EventDescription</p>
                        <p class="mb-1"><strong>Venue:</strong> @ev.Venue, @ev.City</p>
                        <p><strong>Organiser:</strong> @ev.OrganiserName</p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <a asp-action="EventDetails" asp-route-id="@ev.EventId" class="btn btn-outline-primary w-100">View Details & Enrol</a>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12"><p class="text-muted">No events available right now.</p></div>
        }
    </div>
</div>